node_modules
dist
.vite
coverage
tsconfig.tsbuildinfo

# Scratch outputs from debug scripts / probes (e.g. tests/integration/ai-upscale-*).
tmp/

# AI upscale model files — multi-MB ONNX binaries. Users supply their
# own via the Convert panel's "Attach custom model" affordance, or
# drop them in here for the Node CLI bake (`npm run poncho:convert`).
# Never committed.
public/models/*
!public/models/.gitkeep

# ONNX Runtime Web runtime assets — copied from node_modules by
# `npm run setup:ort`. ~74 MB of WASM; rebuilt on every `npm install`.
public/ort/*
!public/ort/.gitkeep

# OS noise
**/.DS_Store
*.log

# Local Claude Code settings (never commit these)
.claude/

# Game ROMs (commercial titles dropped in for the dev server) — never commit.
roms/*
!roms/.gitkeep

# Test ROMs (free + redistributable, but big binaries) — keep out of git.
# Tests skipIf the file is missing, so CI is fine without them.
tests/roms/*
!tests/roms/.gitkeep
# Synthetic PonchoROMs are small + deterministic; they're committed.
!tests/roms/poncho/
!tests/roms/poncho/**
