{
  "name": "poncho",
  "version": "0.1.0",
  "description": "A handcrafted Nintendo Entertainment System emulator written in TypeScript, runs in the browser.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Ivailo Ivanov <dajungle@gmail.com>",
  "homepage": "https://github.com/DaJungle79/poncho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaJungle79/poncho.git"
  },
  "bugs": {
    "url": "https://github.com/DaJungle79/poncho/issues"
  },
  "keywords": [
    "nes",
    "nintendo",
    "emulator",
    "6502",
    "2a03",
    "2c02",
    "typescript",
    "browser",
    "webaudio"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "screenshot": "tsx scripts/render-screenshot.ts \"roms/Contra (USA).nes\" docs/screenshot.png 240 2",
    "gen:poncho:solid-bg": "tsx scripts/gen-poncho-rom/solid-bg.ts",
    "gen:poncho:palette-write": "tsx scripts/gen-poncho-rom/palette-write.ts",
    "gen:poncho:solid-tile": "tsx scripts/gen-poncho-rom/solid-tile.ts",
    "gen:poncho:single-sprite": "tsx scripts/gen-poncho-rom/single-sprite.ts",
    "gen:poncho:nmi-scroll": "tsx scripts/gen-poncho-rom/nmi-scroll.ts",
    "gen:poncho:compat-bg": "tsx scripts/gen-poncho-rom/compat-bg.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "lucide": "^1.14.0"
  }
}
